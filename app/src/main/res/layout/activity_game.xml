<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false"
    android:background="@color/night_purple">

    <!-- Bối cảnh nền sảnh RPG -->
    <ImageView
        android:id="@+id/imgBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/overlay_dark"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Khung thông tin bản stub trò chơi -->
    <LinearLayout
        android:id="@+id/ll_game_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_panel_wood"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_game_greeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chào, Hiệp Sĩ - Kiếm Sĩ Lv1 - HP: 120/120 | ATK: 12"
            android:textColor="@color/ancient_gold"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:letterSpacing="0.04"
            android:shadowColor="#CC000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="6" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="TODO: Thay thế khu vực này bằng GameSurfaceView cho bản đồ 2D Fantasy"
            android:textColor="@color/ivory_white"
            android:textSize="13sp"
            android:fontFamily="serif" />

        <Button
            android:id="@+id/btn_game_back_menu"
            android:layout_width="160dp"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/btn_wood_selector"
            android:stateListAnimator="@animator/btn_scale_animator"
            android:text="@string/btn_back"
            android:textColor="@color/ivory_white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:textAllCaps="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
