<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ll_dialog_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_settings"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="18dp"
    android:paddingBottom="18dp">

    <!-- Tiêu đề CÀI ĐẶT -->
    <TextView
        android:id="@+id/tv_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/dialog_settings_title"
        android:textColor="@color/ancient_gold"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:letterSpacing="0.06"
        android:shadowColor="#CC000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="6" />

    <!-- Đường kẻ phân cách vàng cổ mờ -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:background="#4DE8C170" />

    <!-- Hàng 1: Âm thanh hiệu ứng -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_sfx_label"
            android:textColor="@color/ivory_white"
            android:textSize="15sp"
            android:fontFamily="serif"
            android:textStyle="bold" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_sfx"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:track="@drawable/switch_track_selector"
            app:track="@drawable/switch_track_selector"
            android:thumb="@drawable/switch_thumb_selector"
            app:splitTrack="false"
            app:showText="false" />
    </LinearLayout>

    <!-- Hàng 2: Nhạc nền -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_bgm_label"
            android:textColor="@color/ivory_white"
            android:textSize="15sp"
            android:fontFamily="serif"
            android:textStyle="bold" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_bgm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:track="@drawable/switch_track_selector"
            app:track="@drawable/switch_track_selector"
            android:thumb="@drawable/switch_thumb_selector"
            app:splitTrack="false"
            app:showText="false" />
    </LinearLayout>

    <!-- Hàng 3: Toàn màn hình -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_fullscreen_label"
            android:textColor="@color/ivory_white"
            android:textSize="15sp"
            android:fontFamily="serif"
            android:textStyle="bold" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_fullscreen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:track="@drawable/switch_track_selector"
            app:track="@drawable/switch_track_selector"
            android:thumb="@drawable/switch_thumb_selector"
            app:splitTrack="false"
            app:showText="false" />
    </LinearLayout>

    <!-- Nút ĐÓNG kiểu gỗ -->
    <Button
        android:id="@+id/btn_dialog_close"
        android:layout_width="150dp"
        android:layout_height="38dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:background="@drawable/btn_wood_selector"
        android:stateListAnimator="@animator/btn_scale_animator"
        android:text="@string/btn_close"
        android:textColor="@color/ivory_white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:textAllCaps="false"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:padding="0dp" />

</LinearLayout>
