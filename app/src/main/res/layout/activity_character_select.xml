<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_char_select"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false"
    android:background="@color/night_purple">

    <!-- Bối cảnh nền sảnh RPG tràn viền không padding -->
    <ImageView
        android:id="@+id/imgBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Lớp phủ tối nhẹ bảo đảm tương phản -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/overlay_dark"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Guidelines chia tỉ lệ 3 cột (31% | 38% | 31%) -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.31" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.69" />

    <!-- CỘT 1 (TRÁI): CHỨC NGHIỆP & 2 CARD CHỌN JOB -->
    <LinearLayout
        android:id="@+id/ll_col_left"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guideline_left"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tv_title_job"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/char_select_screen_title"
            android:textColor="@color/ancient_gold"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:letterSpacing="0.06"
            android:shadowColor="#CC000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="6" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="10dp"
            android:background="#4DE8C170" />

        <!-- Card Kiếm Sĩ -->
        <LinearLayout
            android:id="@+id/card_warrior"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_job_selected"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/iv_icon_warrior"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/fallback_char_swordsman"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/job_warrior"
                    android:textColor="@color/ivory_white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="serif" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/warrior_desc_1line"
                android:textColor="#C7B89B"
                android:textSize="12sp"
                android:fontFamily="serif" />
        </LinearLayout>

        <!-- Card Pháp Sư -->
        <LinearLayout
            android:id="@+id/card_mage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_job_normal"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            android:layout_marginTop="10dp"
            android:alpha="0.6">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/iv_icon_mage"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/fallback_char_mage"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/job_mage"
                    android:textColor="@color/ivory_white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="serif" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/mage_desc_1line"
                android:textColor="#C7B89B"
                android:textSize="12sp"
                android:fontFamily="serif" />
        </LinearLayout>
    </LinearLayout>

    <!-- CỘT 2 (GIỮA): HÌNH NHÂN VẬT, VŨ KHÍ & NÚT BẮT ĐẦU -->
    <LinearLayout
        android:id="@+id/ll_col_center"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintStart_toEndOf="@id/guideline_left"
        app:layout_constraintEnd_toStartOf="@id/guideline_right"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tv_title_create"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/char_create_title"
            android:textColor="@color/ancient_gold"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:letterSpacing="0.06"
            android:shadowColor="#CC000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="6" />

        <!-- Ảnh nhân vật lớn (pixel art fitCenter) -->
        <ImageView
            android:id="@+id/iv_char_preview"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:src="@drawable/fallback_char_swordsman"
            android:contentDescription="@null"
            android:layout_marginTop="6dp" />

        <!-- Ô hiển thị vũ khí khởi đầu -->
        <LinearLayout
            android:id="@+id/ll_weapon_box"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_input_dark"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:layout_marginTop="8dp">

            <ImageView
                android:id="@+id/iv_weapon_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/fallback_weapon_sword"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/start_weapon_label"
                android:textColor="#A89888"
                android:textSize="12sp"
                android:fontFamily="serif" />

            <TextView
                android:id="@+id/tv_weapon_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kiếm Tân Thủ"
                android:textColor="@color/ancient_gold"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="serif" />
        </LinearLayout>

        <!-- Nút Bắt đầu hành trình -->
        <Button
            android:id="@+id/btn_start"
            android:layout_width="210dp"
            android:layout_height="42dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/btn_wood_selector"
            android:stateListAnimator="@animator/btn_scale_animator"
            android:text="@string/btn_start"
            android:textColor="@color/ivory_white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:textAllCaps="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp" />
    </LinearLayout>

    <!-- CỘT 3 (PHẢI): TÊN NHÂN VẬT & BẢNG CHỈ SỐ (BỌC TRONG SCROLLVIEW) -->
    <ScrollView
        android:id="@+id/sv_col_right"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintStart_toEndOf="@id/guideline_right"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Khung Tên nhân vật + nút Xúc xắc -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:text="@string/char_name_title"
                android:textColor="@color/ancient_gold"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="serif" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_input_dark"
                android:paddingStart="10dp"
                android:paddingEnd="4dp"
                android:layout_marginTop="4dp">

                <EditText
                    android:id="@+id/et_char_name"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/hint_char_name"
                    android:textColorHint="@color/hint_warm_gray"
                    android:textColor="@color/ivory_white"
                    android:textSize="14sp"
                    android:maxLength="12"
                    android:singleLine="true"
                    android:inputType="textPersonName"
                    android:imeOptions="actionDone" />

                <ImageButton
                    android:id="@+id/btn_dice"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="10dp"
                    android:scaleType="centerInside"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_dice"
                    android:contentDescription="@string/desc_dice" />
            </LinearLayout>

            <!-- Bảng Chỉ số (Máu, Công, Tầm đánh) -->
            <LinearLayout
                android:id="@+id/ll_stats_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_panel_wood"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/char_stats_title"
                    android:textColor="@color/ancient_gold"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:layout_marginBottom="6dp" />

                <!-- Dòng Máu -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:text="@string/stat_hp"
                        android:textColor="@color/ivory_white"
                        android:textSize="12sp"
                        android:fontFamily="serif" />

                    <ProgressBar
                        android:id="@+id/pb_hp"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="0dp"
                        android:layout_height="8dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="8dp"
                        android:max="120"
                        android:progress="120"
                        android:progressDrawable="@drawable/progress_hp" />

                    <TextView
                        android:id="@+id/tv_hp_val"
                        android:layout_width="54dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="120/120"
                        android:textColor="@color/ivory_white"
                        android:textSize="11sp"
                        android:fontFamily="serif" />
                </LinearLayout>

                <!-- Dòng Công -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="2dp">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:text="@string/stat_atk"
                        android:textColor="@color/ivory_white"
                        android:textSize="12sp"
                        android:fontFamily="serif" />

                    <ProgressBar
                        android:id="@+id/pb_atk"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="0dp"
                        android:layout_height="8dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="8dp"
                        android:max="18"
                        android:progress="12"
                        android:progressDrawable="@drawable/progress_atk" />

                    <TextView
                        android:id="@+id/tv_atk_val"
                        android:layout_width="54dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="12"
                        android:textColor="@color/ivory_white"
                        android:textSize="11sp"
                        android:fontFamily="serif" />
                </LinearLayout>

                <!-- Dòng Tầm đánh -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="2dp">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:text="@string/stat_range"
                        android:textColor="@color/ivory_white"
                        android:textSize="12sp"
                        android:fontFamily="serif" />

                    <ProgressBar
                        android:id="@+id/pb_range"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="0dp"
                        android:layout_height="8dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="8dp"
                        android:max="100"
                        android:progress="40"
                        android:progressDrawable="@drawable/progress_range" />

                    <TextView
                        android:id="@+id/tv_range_val"
                        android:layout_width="54dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="@string/range_near"
                        android:textColor="@color/ivory_white"
                        android:textSize="11sp"
                        android:fontFamily="serif" />
                </LinearLayout>
            </LinearLayout>

            <!-- Thông báo lỗi -->
            <TextView
                android:id="@+id/tv_char_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/error_red"
                android:textSize="11sp"
                android:layout_marginTop="4dp"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
